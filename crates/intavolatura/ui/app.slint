import { ComboBox, Button, AboutSlint, CheckBox, SpinBox, Palette, ScrollView, Slider } from "std-widgets.slint";
import "../fonts/Bravura.otf";
import { KeyPicker } from "key_picker.slint";
import { ShortcutsPanel } from "help.slint";
import { DurationBar } from "durations.slint";

// Text centred on (x, y); see `view.rs`.
export struct Glyph {
    x: length,
    y: length,
    text: string,
    music: bool,
    size: length,
    faded: bool,
    warning: bool,
}

// A filled curve, as SVG path commands in the pixels of its box.
export struct Tie {
    x: length,
    y: length,
    width: length,
    height: length,
    commands: string,
}

export struct Bar {
    x: length,
    y: length,
    width: length,
    height: length,
    // Painted in the background colour to clear lines behind a glyph.
    knockout: bool,
}

export component AppWindow inherits Window {
    title: root.window-title;
    preferred-width: 1080px;
    preferred-height: 800px;
    background: root.paper;
    forward-focus: main;

    // 0 follows the system, 1 is light, 2 is dark.
    in-out property <int> theme;

    init => {
        root.apply-theme();
    }
    changed theme => {
        root.apply-theme();
    }

    function apply-theme() {
        Palette.color-scheme = root.theme == 1 ? ColorScheme.light : root.theme == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }

    // Score colours: ink on paper, light or dark with the widgets. Judged
    // from the widgets' own background, since the scheme reads as `unknown`
    // when it follows the system.
    property <bool> dark: Palette.background.to-hsv().value < 0.5;
    property <color> paper: root.dark ? #1e1c19 : #fbfaf6;
    property <color> ink: root.dark ? #e9e5db : #1d1d1d;
    property <color> faded-ink: root.dark ? #8c8578 : #a09a8c;
    property <color> highlight: root.dark ? #3b362d : #ece6d6;
    property <color> muted: root.dark ? #a9a294 : #6b6b6b;
    property <color> panel: root.dark ? #2a2723 : #ffffff;
    property <color> panel-border: root.dark ? #4a453c : #cccccc;
    property <color> warning: root.dark ? #ff8a7a : #c0392b;

    in property <string> window-title: "Intavolatura";
    in property <[Glyph]> glyphs;
    in property <[Bar]> bars;
    in property <[Tie]> ties;
    in property <length> content-width;
    in property <length> content-height;
    // Key names in `Key::all()` order, and the current key with its signature.
    in property <[string]> keys;
    in property <string> key-label;
    // "⌘" on macOS, "Ctrl" elsewhere, for the shortcuts overview.
    in property <string> command-key: "Ctrl";
    in-out property <int> key-index;
    in-out property <int> tablature-index;
    // Time signatures as shown in the picker, and the current one.
    in property <[string]> time-signatures;
    in-out property <int> time-index;
    // Upbeat choices for the current time signature; 0 is no upbeat.
    in property <[string]> upbeats;
    in-out property <int> upbeat-index;
    // The current duration: index into whole … sixteenth, and the dot.
    in property <int> duration-value;
    in property <bool> duration-dotted;
    in property <bool> has-selection;
    in property <length> selection-x;
    in property <length> selection-width;
    in property <length> column-width;
    in property <bool> editing;
    in property <length> edit-x;
    in property <length> edit-y;
    in-out property <string> figuring-text;
    in property <bool> figuring-error;
    in property <string> status;
    in-out property <length> scroll-x;
    out property <length> view-width: flick.width;

    // Settings popup.
    in-out property <bool> show-hints;
    in-out property <bool> retune-diapasons;
    in-out property <int> fret-span;
    in-out property <int> candidates-to-cycle;
    in-out property <int> sign-size;
    in-out property <bool> italian-on-line;
    in-out property <bool> french-on-line;

    // PDF export: contents, page size and staff height in mm.
    in-out property <int> print-contents;
    in-out property <int> page-size;
    in-out property <int> staff-mm;
    callback export-pdf();

    // Playback: the tempo is the file's, the rest are preferences.
    in property <bool> playing;
    in property <bool> has-playhead;
    in property <length> playhead-x;
    in property <length> playhead-width;
    in-out property <int> tempo;
    in-out property <int> play-source;
    in-out property <int> a4;
    in-out property <int> spread-ms;
    in-out property <float> volume;
    // The instrument: its names in picker order, and the current one.
    in property <[string]> instruments;
    in-out property <int> instrument-index;
    callback instrument-selected(int);
    callback play-toggled();
    callback tempo-edited(int);

    // A click in content coordinates.
    callback clicked(length, length);
    // A key press: text, shift, control (command on macOS). Returns whether handled.
    callback key(string, bool, bool) -> bool;
    callback key-selected(int);
    callback tablature-selected(int);
    callback time-selected(int);
    callback upbeat-selected(int);
    // A new time signature from the selected note: 0 removes it, then the
    // time signatures in picker order.
    callback meter-change-selected(int);
    callback duration-selected(int);
    callback dot-toggled();
    callback figuring-edited(string);
    callback figuring-accepted(string);
    callback open-file();
    callback save-file();
    // MusicXML export: with the realization part, or the figured bass only.
    callback export-file(bool);
    // MusicXML import: the parts to choose from, and what changed.
    in property <[string]> import-parts;
    in property <[string]> import-changes;
    callback import-part(int);
    callback preferences-changed();

    public function choose-meter-change() {
        meter-change-popup.show();
    }

    public function show-playback() {
        playback.show();
    }

    public function show-export() {
        export.show();
    }

    public function show-settings() {
        settings.show();
    }

    public function choose-import-part() {
        import-parts-popup.show();
    }

    public function show-import-report() {
        import-report.show();
    }

    public function show-shortcuts() {
        shortcuts.show();
    }

    public function open-key-picker() {
        key-picker.open();
    }

    public function focus-main() {
        main.focus();
    }

    public function focus-figuring() {
        figuring.focus();
        figuring.select-all();
    }

    main := FocusScope {
        key-pressed(event) => {
            if (root.key(event.text, event.modifiers.shift, event.modifiers.control)) {
                return accept;
            }
            reject
        }

        VerticalLayout {
            HorizontalLayout {
                padding: 6px;
                spacing: 8px;
                height: 42px;

                Text {
                    text: "Key";
                    vertical-alignment: center;
                }

                key-picker := KeyPicker {
                    width: 160px;
                    names: root.keys;
                    current: root.key-index;
                    label: root.key-label;
                    ink: root.ink;
                    muted: root.muted;
                    panel: root.panel;
                    panel-border: root.panel-border;
                    highlight: root.highlight;
                    selected(index) => {
                        root.key-selected(index);
                        main.focus();
                    }
                }

                ComboBox {
                    width: 90px;
                    model: root.time-signatures;
                    current-index <=> root.time-index;
                    selected => {
                        root.time-selected(self.current-index);
                        main.focus();
                    }
                }

                ComboBox {
                    width: 120px;
                    model: root.upbeats;
                    current-index <=> root.upbeat-index;
                    selected => {
                        root.upbeat-selected(self.current-index);
                        main.focus();
                    }
                }

                DurationBar {
                    value: root.duration-value;
                    dotted: root.duration-dotted;
                    ink: root.ink;
                    muted: root.muted;
                    highlight: root.highlight;
                    panel-border: root.panel-border;
                    value-selected(index) => {
                        root.duration-selected(index);
                        main.focus();
                    }
                    dot-toggled => {
                        root.dot-toggled();
                        main.focus();
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                Button {
                    // Icon only, to keep the header narrow; Space plays too.
                    accessible-label: root.playing ? "Stop" : "Play";
                    Tooltip {
                        text: root.playing ? @markdown("Stop (Space or Esc)") : @markdown("Play from the selected note (Space)");
                    }

                    icon: root.playing ? @image-url("icons/square.svg") : @image-url("icons/play.svg");
                    colorize-icon: true;
                    clicked => {
                        root.play-toggled();
                        main.focus();
                    }
                }

                Button {
                    accessible-label: "Playback settings";
                    Tooltip {
                        text: @markdown("Playback settings: tempo, pitch, spread");
                    }

                    icon: @image-url("icons/timer.svg");
                    colorize-icon: true;
                    clicked => {
                        playback.show();
                    }
                }

                Button {
                    accessible-label: "Open";
                    Tooltip {
                        text: @markdown("Open a file (\{root.command-key} O)");
                    }

                    icon: @image-url("icons/folder-open.svg");
                    colorize-icon: true;
                    clicked => {
                        root.open-file();
                        main.focus();
                    }
                }

                Button {
                    accessible-label: "Save";
                    Tooltip {
                        text: @markdown("Save (\{root.command-key} S)");
                    }

                    icon: @image-url("icons/save.svg");
                    colorize-icon: true;
                    clicked => {
                        root.save-file();
                        main.focus();
                    }
                }

                Button {
                    accessible-label: "Export";
                    Tooltip {
                        text: @markdown("Export as MusicXML or PDF");
                    }

                    icon: @image-url("icons/file-output.svg");
                    colorize-icon: true;
                    clicked => {
                        export.show();
                    }
                }

                Button {
                    // Icon only, to keep the header narrow; the shortcut
                    // overview and popups say what they are.
                    accessible-label: "Keys";
                    Tooltip {
                        text: @markdown("Keyboard shortcuts (? or F1)");
                    }

                    icon: @image-url("icons/keyboard.svg");
                    colorize-icon: true;
                    clicked => {
                        shortcuts.show();
                    }
                }

                Button {
                    // Icon only, to keep the header narrow; the shortcut
                    // overview and popups say what they are.
                    accessible-label: "Settings";
                    Tooltip {
                        text: @markdown("Settings");
                    }

                    icon: @image-url("icons/settings.svg");
                    colorize-icon: true;
                    clicked => {
                        settings.show();
                    }
                }

                Button {
                    // Icon only, to keep the header narrow; the shortcut
                    // overview and popups say what they are.
                    accessible-label: "About";
                    Tooltip {
                        text: @markdown("About");
                    }

                    icon: @image-url("icons/info.svg");
                    colorize-icon: true;
                    clicked => {
                        about.show();
                    }
                }
            }

            flick := Flickable {
                content-width: max(root.content-width, self.width);
                content-height: max(root.content-height, self.height);
                content-x <=> root.scroll-x;

                if root.has-selection: Rectangle {
                    x: root.selection-x;
                    y: 0;
                    width: root.selection-width;
                    height: flick.content-height;
                    background: root.highlight;
                }

                if root.has-playhead: Rectangle {
                    x: root.playhead-x;
                    y: 0;
                    width: root.playhead-width;
                    height: flick.content-height;
                    background: Palette.accent-background.with-alpha(0.22);
                }

                for bar in root.bars: Rectangle {
                    x: bar.x;
                    y: bar.y;
                    width: bar.width;
                    height: bar.height;
                    background: !bar.knockout ? root.ink : root.has-selection && bar.x >= root.selection-x && bar.x < root.selection-x + root.selection-width ? root.highlight : root.paper;
                }

                for tie in root.ties: Path {
                    x: tie.x;
                    y: tie.y;
                    width: tie.width;
                    height: tie.height;
                    viewbox-width: tie.width / 1px;
                    viewbox-height: tie.height / 1px;
                    commands: tie.commands;
                    fill: root.ink;
                }

                for glyph in root.glyphs: Text {
                    x: glyph.x - 60px;
                    y: glyph.y - glyph.size;
                    width: 120px;
                    height: 2 * glyph.size;
                    text: glyph.text;
                    font-family: glyph.music ? "Bravura" : "";
                    font-size: glyph.size;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    color: glyph.warning ? root.warning : glyph.faded ? root.faded-ink : root.ink;
                }

                TouchArea {
                    width: flick.content-width;
                    height: flick.content-height;
                    clicked => {
                        root.clicked(self.pressed-x, self.pressed-y);
                    }
                }

                Rectangle {
                    visible: root.editing;
                    x: root.edit-x - 36px;
                    y: root.edit-y;
                    width: 72px;
                    height: 26px;
                    background: root.panel;
                    border-width: 1.5px;
                    border-radius: 3px;
                    border-color: root.figuring-error ? #c0392b : #5a8f6a;

                    figuring := TextInput {
                        x: 6px;
                        width: parent.width - 12px;
                        vertical-alignment: center;
                        color: root.ink;
                        text <=> root.figuring-text;
                        edited => {
                            root.figuring-edited(self.text);
                        }
                        accepted => {
                            root.figuring-accepted(self.text);
                        }
                    }
                }
            }

            Rectangle {
                height: 36px;
                background: root.panel;
                border-width: 0px;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;

                    Text {
                        text: root.status;
                        vertical-alignment: center;
                        color: root.muted;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }

                    ComboBox {
                        width: 310px;
                        model: root.instruments;
                        current-index <=> root.instrument-index;
                        selected => {
                            root.instrument-selected(self.current-index);
                            main.focus();
                        }
                    }
                }
            }
        }
    }

    playback := PopupWindow {
        x: root.width - 480px;
        y: 44px;
        width: 320px;
        close-policy: close-on-click-outside;

        Rectangle {
            background: root.panel;
            border-width: 1px;
            border-color: root.panel-border;
            border-radius: 4px;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                Text {
                    text: "Playback";
                    font-weight: 600;
                    color: root.ink;
                }

                HorizontalLayout {
                    spacing: 8px;

                    Text {
                        text: "Tempo (quarter notes a minute)";
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    SpinBox {
                        width: 90px;
                        minimum: 20;
                        maximum: 300;
                        value <=> root.tempo;
                        edited(value) => {
                            root.tempo-edited(value);
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;

                    Text {
                        text: "Play";
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    ComboBox {
                        width: 160px;
                        model: ["Chords as fingered", "Bass notes only"];
                        current-index <=> root.play-source;
                        selected => {
                            root.preferences-changed();
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;

                    Text {
                        text: "Pitch, A4 (Hz)";
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    SpinBox {
                        width: 90px;
                        minimum: 380;
                        maximum: 480;
                        value <=> root.a4;
                        edited(value) => {
                            root.preferences-changed();
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 4px;

                    for hz in [392, 415, 430, 440, 466]: Button {
                        text: hz;
                        primary: root.a4 == hz;
                        clicked => {
                            root.a4 = hz;
                            root.preferences-changed();
                        }
                    }
                }

                Text {
                    text: "415 baroque · 392 French baroque · 430 classical · 440 modern · 466 Venetian";
                    wrap: word-wrap;
                    color: root.muted;
                }

                HorizontalLayout {
                    spacing: 8px;

                    Text {
                        text: "Arpeggio spread (ms)";
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    SpinBox {
                        width: 90px;
                        minimum: 0;
                        maximum: 100;
                        step-size: 5;
                        value <=> root.spread-ms;
                        edited(value) => {
                            root.preferences-changed();
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;

                    Text {
                        text: "Volume";
                        vertical-alignment: center;
                    }

                    Slider {
                        minimum: 0;
                        maximum: 100;
                        value <=> root.volume;
                        released => {
                            root.preferences-changed();
                        }
                    }
                }

                Text {
                    text: "Space plays from the selected note and stops; Esc stops too.";
                    wrap: word-wrap;
                    color: root.muted;
                }
            }
        }
    }

    settings := PopupWindow {
        x: root.width - 330px;
        y: 44px;
        width: 310px;
        close-policy: close-on-click-outside;

        Rectangle {
            background: root.panel;
            border-width: 1px;
            border-color: root.panel-border;
            border-radius: 4px;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                Text {
                    text: "Settings";
                    font-weight: 600;
                }

                HorizontalLayout {
                    spacing: 8px;

                    Text {
                        text: "Theme";
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    ComboBox {
                        width: 110px;
                        model: ["System", "Light", "Dark"];
                        current-index <=> root.theme;
                        selected => {
                            root.preferences-changed();
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;

                    Text {
                        text: "Tablature";
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    ComboBox {
                        width: 110px;
                        model: ["Italian", "French"];
                        current-index <=> root.tablature-index;
                        selected => {
                            root.tablature-selected(self.current-index);
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;

                    Text {
                        text: "Tablature sign size (%)";
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    SpinBox {
                        width: 90px;
                        minimum: 50;
                        maximum: 150;
                        step-size: 10;
                        value <=> root.sign-size;
                        edited(value) => {
                            root.preferences-changed();
                        }
                    }
                }

                CheckBox {
                    text: "Italian signs rest on the line";
                    checked <=> root.italian-on-line;
                    toggled => {
                        root.preferences-changed();
                    }
                }

                CheckBox {
                    text: "French signs rest on the line";
                    checked <=> root.french-on-line;
                    toggled => {
                        root.preferences-changed();
                    }
                }

                CheckBox {
                    text: "Show leading-tone hints";
                    checked <=> root.show-hints;
                    toggled => {
                        root.preferences-changed();
                    }
                }

                CheckBox {
                    text: "Retune diapasons to the key";
                    checked <=> root.retune-diapasons;
                    toggled => {
                        root.preferences-changed();
                    }
                }

                HorizontalLayout {
                    spacing: 8px;

                    Text {
                        text: "Left-hand fret span";
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    SpinBox {
                        width: 90px;
                        minimum: 2;
                        maximum: 6;
                        value <=> root.fret-span;
                        edited(value) => {
                            root.preferences-changed();
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;

                    Text {
                        text: "Fingerings to cycle with [ and ]";
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    SpinBox {
                        width: 90px;
                        minimum: 1;
                        maximum: 50;
                        value <=> root.candidates-to-cycle;
                        edited(value) => {
                            root.preferences-changed();
                        }
                    }
                }
            }
        }
    }

    meter-change-popup := PopupWindow {
        x: 300px;
        y: 44px;
        width: 220px;
        close-policy: close-on-click-outside;

        Rectangle {
            background: root.panel;
            border-width: 1px;
            border-color: root.panel-border;
            border-radius: 4px;

            VerticalLayout {
                padding: 10px;
                spacing: 4px;

                Text {
                    text: "Time signature from this note";
                    font-weight: 600;
                    color: root.ink;
                }

                Button {
                    text: "No change here";
                    clicked => {
                        meter-change-popup.close();
                        root.meter-change-selected(0);
                        main.focus();
                    }
                }

                for name[i] in root.time-signatures: Button {
                    text: name;
                    clicked => {
                        meter-change-popup.close();
                        root.meter-change-selected(i + 1);
                        main.focus();
                    }
                }
            }
        }
    }

    import-parts-popup := PopupWindow {
        x: 60px;
        y: 44px;
        width: 360px;
        close-policy: no-auto-close;

        Rectangle {
            background: root.panel;
            border-width: 1px;
            border-color: root.panel-border;
            border-radius: 4px;

            VerticalLayout {
                padding: 12px;
                spacing: 6px;

                Text {
                    text: "Import which part?";
                    font-weight: 600;
                    color: root.ink;
                }

                Text {
                    text: "The bass line and its figures are read from the part you choose.";
                    wrap: word-wrap;
                    color: root.muted;
                }

                for name[i] in root.import-parts: Button {
                    text: name;
                    clicked => {
                        import-parts-popup.close();
                        root.import-part(i);
                        main.focus();
                    }
                }

                Button {
                    text: "Cancel";
                    clicked => {
                        import-parts-popup.close();
                        main.focus();
                    }
                }
            }
        }
    }

    import-report := PopupWindow {
        x: 60px;
        y: 44px;
        width: 520px;
        close-policy: close-on-click-outside;

        Rectangle {
            background: root.panel;
            border-width: 1px;
            border-color: root.panel-border;
            border-radius: 4px;

            VerticalLayout {
                padding: 12px;
                spacing: 6px;

                Text {
                    text: "Changed while importing";
                    font-weight: 600;
                    color: root.ink;
                }

                ScrollView {
                    height: min(320px, root.import-changes.length * 24px + 8px);

                    VerticalLayout {
                        spacing: 6px;
                        alignment: start;

                        for change in root.import-changes: Text {
                            text: "• " + change;
                            wrap: word-wrap;
                            color: root.ink;
                        }
                    }
                }

                Button {
                    text: "OK";
                    clicked => {
                        import-report.close();
                        main.focus();
                    }
                }
            }
        }
    }

    export := PopupWindow {
        x: root.width - 600px;
        y: 44px;
        width: 300px;
        close-policy: close-on-click-outside;

        Rectangle {
            background: root.panel;
            border-width: 1px;
            border-color: root.panel-border;
            border-radius: 4px;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                Text {
                    text: "Export as MusicXML";
                    font-weight: 600;
                    color: root.ink;
                }

                Button {
                    text: "Figured bass and realization";
                    clicked => {
                        export.close();
                        root.export-file(true);
                        main.focus();
                    }
                }

                Button {
                    text: "Figured bass only";
                    clicked => {
                        export.close();
                        root.export-file(false);
                        main.focus();
                    }
                }

                Text {
                    text: "Opens in MuseScore, Dorico, Sibelius and other notation programs. Tablature is not included.";
                    wrap: word-wrap;
                    color: root.muted;
                }

                Rectangle {
                    height: 1px;
                    background: root.panel-border;
                }

                Text {
                    text: "Export as PDF";
                    font-weight: 600;
                    color: root.ink;
                }

                ComboBox {
                    model: ["Tablature", "Figured bass and tablature", "Figured bass, realization and tablature"];
                    current-index <=> root.print-contents;
                    selected => {
                        root.preferences-changed();
                    }
                }

                HorizontalLayout {
                    spacing: 8px;

                    Text {
                        text: "Page";
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    ComboBox {
                        width: 110px;
                        model: ["A4", "Letter"];
                        current-index <=> root.page-size;
                        selected => {
                            root.preferences-changed();
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;

                    Text {
                        text: "Staff height (mm)";
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    SpinBox {
                        width: 90px;
                        minimum: 5;
                        maximum: 12;
                        value <=> root.staff-mm;
                        edited(value) => {
                            root.preferences-changed();
                        }
                    }
                }

                Button {
                    text: "Save PDF…";
                    clicked => {
                        export.close();
                        root.export-pdf();
                        main.focus();
                    }
                }

                Text {
                    text: "Tablature style, sign size and placement follow the settings.";
                    wrap: word-wrap;
                    color: root.muted;
                }
            }
        }
    }

    shortcuts := PopupWindow {
        x: max(0px, root.width - 760px);
        y: 44px;
        width: min(root.width, 750px);
        close-policy: close-on-click-outside;

        Rectangle {
            background: root.panel;
            border-width: 1px;
            border-color: root.panel-border;
            border-radius: 4px;

            ShortcutsPanel {
                command: root.command-key;
                ink: root.ink;
                muted: root.muted;
            }
        }
    }

    about := PopupWindow {
        x: root.width - 380px;
        y: 44px;
        width: 360px;

        Rectangle {
            background: root.panel;
            border-width: 1px;
            border-color: root.panel-border;
            border-radius: 4px;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                Text {
                    text: "Intavolatura: figured bass realized for theorbo";
                    font-weight: 600;
                }

                AboutSlint { }

                Text {
                    text: "Music font: Bravura © Steinberg Media Technologies, SIL Open Font License 1.1. Icons: Lucide, ISC License.";
                    wrap: word-wrap;
                    color: root.muted;
                }
            }
        }
    }
}
